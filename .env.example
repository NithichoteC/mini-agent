# AI-Blue environment template.
# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.

# Runtime environment: development | staging | production
AI_BLUE_ENV=development
AI_BLUE_LOG_LEVEL=INFO

# Model-provider credentials — uncomment only the providers you use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Database / knowledge graph (not yet used)
# AI_BLUE_DATABASE_URL=
# AI_BLUE_KG_URL=
